generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                 @id @default(uuid())
  email                   String                 @unique
  passwordHash            String
  role                    Role
  status                  UserStatus             @default(ACTIVE)
  firstName               String
  lastName                String
  phone                   String?
  avatarUrl               String?
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  announcements           Announcement[]         @relation("AnnouncementAuthor")
  auditLogs               AuditLog[]
  addedEligibleEmails     EligibleStudentEmail[] @relation("AdminEligibleEmails")
  enteredResults          ExamResult[]           @relation("ResultEnteredBy")
  updatedResults          ExamResult[]           @relation("ResultUpdatedBy")
  resultHistory           ExamResultHistory[]    @relation("ResultHistoryChangedBy")
  recordedPayments        FeePayment[]           @relation("PaymentRecordedBy")
  conductedMockInterviews MockInterview[]        @relation("MockInterviewConductedBy")
  enteredMockResults      MockResult[]           @relation("MockResultEnteredBy")
  createdExams            OfflineExam[]          @relation("ExamCreatedBy")
  publishedExams          OfflineExam[]          @relation("ExamPublishedBy")
  refreshTokens           RefreshToken[]
  reviewedRequests        RegistrationRequest[]  @relation("RequestReviewer")
  studentProfile          StudentProfile?
  teacherProfile          TeacherProfile?

  @@index([email])
  @@index([firstName])
  @@index([lastName])
  @@index([role, status])
  @@index([phone])
}

model StudentProfile {
  id               String           @id @default(uuid())
  userId           String           @unique
  enrollmentNumber String           @unique
  rollNumber       String?
  guardianName     String?
  guardianPhone    String?
  address          String?
  joinedAt         DateTime         @default(now())
  status           EnrollmentStatus @default(ACTIVE)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  dropOutReason    String?
  exitDate         DateTime?
  joiningDate      DateTime         @default(now())
  journeyStatus    JourneyStatus    @default(ACTIVE)
  announcements    Announcement[]   @relation("IndividualStudentAnnouncements")
  enrollments      Enrollment[]
  examResults      ExamResult[]
  feeRecords       FeeRecord[]
  mockResults      MockResult[]
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([enrollmentNumber])
  @@index([journeyStatus])
  @@index([joiningDate])
  @@index([rollNumber])
}

model TeacherProfile {
  id             String              @id @default(uuid())
  userId         String              @unique
  employeeId     String              @unique
  specialization String?
  qualifications String?
  bio            String?
  joinedAt       DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  showOnWebsite  Boolean             @default(true)
  assignments    TeacherAssignment[]
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([showOnWebsite])
}

model EligibleStudentEmail {
  id               String   @id @default(uuid())
  email            String   @unique
  fullName         String
  offlineRegNumber String?  @unique
  phone            String?
  courseHint       String?
  isRegistered     Boolean  @default(false)
  addedByAdminId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  addedByAdmin     User?    @relation("AdminEligibleEmails", fields: [addedByAdminId], references: [id])

  @@index([email])
  @@index([isRegistered])
}

model RegistrationRequest {
  id                    String        @id @default(uuid())
  email                 String
  fullName              String
  phone                 String?
  role                  Role
  passwordHash          String
  verificationTokenHash String?
  tokenExpiresAt        DateTime?
  isEmailVerified       Boolean       @default(false)
  status                RequestStatus @default(PENDING)
  reviewNote            String?
  reviewerId            String?
  reviewedAt            DateTime?
  targetCourseId        String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  reviewer              User?         @relation("RequestReviewer", fields: [reviewerId], references: [id])

  @@index([email])
  @@index([status, role])
}

model Course {
  id             String          @id @default(uuid())
  title          String
  slug           String          @unique
  description    String
  curriculum     Json?
  duration       String
  advertisedFee  Float           @default(0.0)
  thumbnailUrl   String?
  featured       Boolean         @default(false)
  published      Boolean         @default(false)
  displayOrder   Int             @default(0)
  isArchived     Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  announcements  Announcement[]
  batches        Batch[]
  enrollments    Enrollment[]
  feeRecords     FeeRecord[]
  mockInterviews MockInterview[]
  offlineExams   OfflineExam[]

  @@index([slug])
  @@index([published, featured])
}

model Batch {
  id             String              @id @default(uuid())
  name           String
  batchCode      String              @unique
  courseId       String
  startDate      DateTime
  endDate        DateTime?
  timing         String?
  capacity       Int                 @default(30)
  status         BatchStatus         @default(UPCOMING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  announcements  Announcement[]
  course         Course              @relation(fields: [courseId], references: [id])
  enrollments    Enrollment[]
  feeRecords     FeeRecord[]
  mockInterviews MockInterview[]
  offlineExams   OfflineExam[]
  teachers       TeacherAssignment[]

  @@index([batchCode])
  @@index([courseId, status])
}

model TeacherAssignment {
  id         String         @id @default(uuid())
  teacherId  String
  batchId    String
  roleTitle  String?        @default("Primary Instructor")
  assignedAt DateTime       @default(now())
  batch      Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  teacher    TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, batchId])
  @@index([teacherId])
  @@index([batchId])
}

model Enrollment {
  id         String           @id @default(uuid())
  studentId  String
  batchId    String
  courseId   String
  enrolledAt DateTime         @default(now())
  status     EnrollmentStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  batch      Batch            @relation(fields: [batchId], references: [id])
  course     Course           @relation(fields: [courseId], references: [id])
  student    StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, batchId])
  @@index([studentId])
  @@index([batchId])
  @@index([courseId])
}

model OfflineExam {
  id            String       @id @default(uuid())
  title         String
  subject       String
  courseId      String
  batchId       String
  examDate      DateTime
  maxMarks      Float
  description   String?
  status        ExamStatus   @default(DRAFT)
  createdById   String
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  results       ExamResult[]
  batch         Batch        @relation(fields: [batchId], references: [id])
  course        Course       @relation(fields: [courseId], references: [id])
  createdBy     User         @relation("ExamCreatedBy", fields: [createdById], references: [id])
  publishedBy   User?        @relation("ExamPublishedBy", fields: [publishedById], references: [id])

  @@index([batchId, examDate])
  @@index([status])
}

model ExamResult {
  id            String              @id @default(uuid())
  examId        String
  studentId     String
  marksObtained Float
  percentage    Float?
  remarks       String?
  status        ResultStatus        @default(DRAFT)
  enteredById   String
  updatedById   String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  enteredBy     User                @relation("ResultEnteredBy", fields: [enteredById], references: [id])
  exam          OfflineExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  student       StudentProfile      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  updatedBy     User?               @relation("ResultUpdatedBy", fields: [updatedById], references: [id])
  history       ExamResultHistory[]

  @@unique([examId, studentId])
  @@index([studentId])
  @@index([examId, status])
}

model ExamResultHistory {
  id            String     @id @default(uuid())
  resultId      String
  previousMarks Float
  newMarks      Float
  reason        String
  changedById   String
  changedAt     DateTime   @default(now())
  changedBy     User       @relation("ResultHistoryChangedBy", fields: [changedById], references: [id])
  result        ExamResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@index([resultId])
}

model Announcement {
  id              String             @id @default(uuid())
  title           String
  body            String
  authorId        String
  targetType      TargetAudienceType @default(ALL)
  targetCourseId  String?
  targetBatchId   String?
  targetStudentId String?
  priority        PriorityLevel      @default(MEDIUM)
  publishDate     DateTime           @default(now())
  expiryDate      DateTime?
  isPublished     Boolean            @default(true)
  emailSent       Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  author          User               @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  targetBatch     Batch?             @relation(fields: [targetBatchId], references: [id])
  targetCourse    Course?            @relation(fields: [targetCourseId], references: [id])
  targetStudent   StudentProfile?    @relation("IndividualStudentAnnouncements", fields: [targetStudentId], references: [id])

  @@index([targetType, isPublished])
  @@index([publishDate])
}

model StudentSuccessStory {
  id              String   @id @default(uuid())
  studentName     String
  photoUrl        String?
  courseCompleted String
  jobTitle        String
  companyName     String
  companyLogoUrl  String?
  packageLPA      String?
  placementYear   Int
  testimonial     String
  featured        Boolean  @default(false)
  published       Boolean  @default(true)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, featured, displayOrder])
}

model FeeRecord {
  id             String         @id @default(uuid())
  studentId      String
  courseId       String
  batchId        String
  totalFee       Float
  paidAmount     Float          @default(0.0)
  balanceAmount  Float          @default(0.0)
  dueDate        DateTime?
  paymentStatus  PaymentStatus  @default(PENDING)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  discountAmount Float          @default(0.0)
  originalFee    Float          @default(0.0)
  payments       FeePayment[]
  batch          Batch          @relation(fields: [batchId], references: [id])
  course         Course         @relation(fields: [courseId], references: [id])
  student        StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([paymentStatus])
}

model FeePayment {
  id             String    @id @default(uuid())
  feeRecordId    String
  amount         Float
  paymentMethod  String    @default("UPI")
  transactionRef String?
  receiptNumber  String?
  remarks        String?
  paidAt         DateTime  @default(now())
  recordedById   String?
  createdAt      DateTime  @default(now())
  feeRecord      FeeRecord @relation(fields: [feeRecordId], references: [id], onDelete: Cascade)
  recordedBy     User?     @relation("PaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([feeRecordId])
  @@index([paidAt])
}

model MockInterview {
  id            String       @id @default(uuid())
  title         String?
  date          DateTime
  courseId      String
  batchId       String?
  totalMarks    Float        @default(35.0)
  description   String?
  conductedById String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  batch         Batch?       @relation(fields: [batchId], references: [id])
  conductedBy   User?        @relation("MockInterviewConductedBy", fields: [conductedById], references: [id])
  course        Course       @relation(fields: [courseId], references: [id])
  results       MockResult[]

  @@index([courseId, date])
  @@index([date])
}

model MockResult {
  id              String         @id @default(uuid())
  mockInterviewId String
  studentId       String
  marksObtained   Float
  percentage      Float?
  feedback        String?
  status          ResultStatus   @default(PUBLISHED)
  enteredById     String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  enteredBy       User?          @relation("MockResultEnteredBy", fields: [enteredById], references: [id])
  mockInterview   MockInterview  @relation(fields: [mockInterviewId], references: [id], onDelete: Cascade)
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([mockInterviewId, studentId])
  @@index([studentId])
  @@index([mockInterviewId, status])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revoked])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([action, createdAt])
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BatchStatus {
  UPCOMING
  ONGOING
  COMPLETED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ResultStatus {
  DRAFT
  PUBLISHED
}

enum TargetAudienceType {
  ALL
  COURSE
  BATCH
  INDIVIDUAL
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum JourneyStatus {
  ACTIVE
  PLACED
  DROPPED_OUT
}
