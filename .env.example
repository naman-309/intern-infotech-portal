# ==============================================================================
# SOFTWARE ENGINEERING COACHING INSTITUTE PORTAL — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development

# Database (Neon Serverless PostgreSQL)
# Get this from: https://console.neon.tech → Your Project → Connection Details
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<dbname>?sslmode=require

# Redis (Upstash Serverless Redis)
# Get this from: https://console.upstash.com → Your Database → REST API → ioredis
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# Service Ports
PORT_GATEWAY=5000
PORT_AUTH_SERVICE=5001
PORT_USER_SERVICE=5002
PORT_ACADEMIC_SERVICE=5003
PORT_NOTIFICATION_SERVICE=5004

# Service Internal URLs (for Gateway and Inter-service communication)
AUTH_SERVICE_URL=http://localhost:5001
USER_SERVICE_URL=http://localhost:5002
ACADEMIC_SERVICE_URL=http://localhost:5003
NOTIFICATION_SERVICE_URL=http://localhost:5004

# Frontend Configuration
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:5000/api/v1

# Security & JWT Secrets
# Generate random 32+ character secrets in production (e.g. `openssl rand -hex 32`)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_change_in_production
JWT_VERIFY_SECRET=your_email_verification_secret_key_change_in_production
JWT_RESET_SECRET=your_password_reset_secret_key_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Cookie Configuration
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=localhost

# Email Configuration (Nodemailer SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admissions@infotech-academy.edu
SMTP_PASS=your_app_password_here
EMAIL_FROM_NAME="Intern Infotech Engineering Academy"
EMAIL_FROM_ADDRESS="no-reply@infotech-academy.edu"

# Cloudinary Configuration (Image Uploads)
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Initial Admin Bootstrap Configuration (Used only for first-time setup script)
INITIAL_ADMIN_EMAIL=admin@infotech.edu
INITIAL_ADMIN_PASSWORD=ChangeMeAdmin@2026
INITIAL_ADMIN_FIRSTNAME=System
INITIAL_ADMIN_LASTNAME=Administrator
BOOTSTRAP_TOKEN=secure_bootstrap_key_12345
